# 后端服务端口（默认 3001，前端 Vite 已代理 /api 到该端口）
PORT=3001

# AI 持仓管家（CodeBuddy Agent SDK）鉴权方式二选一：
# 方式A（推荐）：在终端执行 `npx codebuddy login` 完成浏览器登录，无需填写下方 Key。
# 方式B：在此填入 API Key（从 CodeBuddy 控制台获取），然后重启后端服务。
# CODEBUDDY_API_KEY=

# 行情数据源 westock 一般不需要配置，只需在宿主机本地安装并扫码授权即可。

# Wind 新闻（万得 MCP）：后端优先读环境变量，其次读 ~/.wind-aifinmarket/config
# WIND_API_KEY=
# 万得 MCP 端点（默认 https://mcp.wind.com.cn/vserver_financial_docs/mcp/，一般无需修改）
# WIND_MCP_ENDPOINT=
